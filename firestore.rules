rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Accounts collection
    match /accounts/{accountId} {
      allow read, write: if true;
    }
    
    // InBody Records collection
    match /records/{recordId} {
      allow read, write: if true;
    }

    // Fallback collection match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
